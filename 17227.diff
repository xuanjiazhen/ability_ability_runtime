+    }
+    CHECK_POINTER_AND_RETURN(uiExtensionAbilityRecordMgr_, ERR_NULL_OBJECT);
+    uiExtensionAbilityRecordMgr_->RegisterPreloadUIExtensionHostClient(callerToken);
