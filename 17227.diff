+        std::shared_ptr<ExtensionRecord> extRecord = std::make_shared<ExtensionRecord>(abilityRecord);
+        extRecord->hostBundleName_ = hostBundleName;
+        
+        extRecord->hostPid_ = (i < 2) ? currentPid : 99999;
