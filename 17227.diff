+    if (callbackRef_ == nullptr) {
+        TAG_LOGE(AAFwkTag::ABILITYMGR, "callbackRef_ null, skip");
+        return;
+    }
+    bool isAttachThread = false;
+    ani_env *env = AttachAniEnv(vm_, isAttachThread);
+    if (env == nullptr) {
+        TAG_LOGE(AAFwkTag::ABILITYMGR, "AttachAniEnv failed");
+        return;
