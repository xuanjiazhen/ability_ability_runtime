+int AbilityConnectManager::UnPreloadUIExtensionAbilityLocked(int32_t extensionAbilityId)
+{
+    std::lock_guard guard(serialMutex_);
+    return UnPreloadUIExtensionAbilityInner(extensionAbilityId);
