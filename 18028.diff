+void HisyseventReport::InsertParam(const char* name, char* value)
+{
+    if (length_ <= pos_) {
+        TAG_LOGE(AAFwkTag::DEFAULT, "param is full");
+        return;
+    }
+    HiSysEventParam param = {
+        .t = HISYSEVENT_STRING,
+        .v = { .s = value},
