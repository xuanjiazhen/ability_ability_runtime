import("//build/ohos.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

# 页面缩放管理库
ohos_shared_library("page_scaling_manager") {
  sources = [
    "services/src/page_scaling_manager.cpp",
  ]
  
  include_dirs = [
    "services/include/",
  ]
  
  external_deps = [
    "json:nlohmann_json_static",
    "hilog:libhilog",
    "c_utils:utils",
  ]
  
  subsystem_name = "ability"
  part_name = "ability_runtime"
}

# 导出头文件
ohos_shared_headers("page_scaling_manager_headers") {
  include_dirs = [ "services/include/" ]
  deps = [
    ":page_scaling_manager",
  ]
  subsystem_name = "ability"
  part_name = "ability_runtime"
}