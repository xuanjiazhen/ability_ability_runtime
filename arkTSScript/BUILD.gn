import("//build/config/components/ets_frontend/es2abc_config.gni")
import("//build/ohos.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

ohos_executable("arkTSScript") {
  output_name = "arkTSScript.bin"
  sources = [ "src/arkTSScript.cpp" ]

  include_dirs = [
    "include",
    "${ability_runtime_innerkits_path}/runtime/include",
    "${ability_runtime_path}/interfaces/kits/native/appkit/ability_runtime/context",
    "${ability_runtime_innerkits_path}/app_manager/include/appmgr",
    "${ability_runtime_innerkits_path}/ability_manager/include",
  ]

  deps = [
    "${ability_runtime_innerkits_path}/runtime:runtime",
    "${ability_runtime_native_path}/appkit:app_context",
    "${ability_runtime_native_path}/appkit:app_context_utils",
  ]

  external_deps = [
    "ability_base:base",
    "bundle_framework:appexecfwk_core",
    "bundle_framework:appexecfwk_base",
    "c_utils:utils",
    "eventhandler:libeventhandler",
    "hilog:libhilog",
    "napi:ace_napi",
    "ipc:ipc_core",
  ]

  cflags = [
    "-Wno-unused-parameter",
    "-Wno-unused-variable",
    "-fexceptions",
  ]

  install_enable = true

  subsystem_name = "ability"
  part_name = "ability_runtime"
}

es2abc_gen_abc("gen_test_script_abc") {
  src_js = rebase_path("test_script.js")
  dst_file = rebase_path(target_out_dir + "/test_script.abc")
  in_puts = [ "test_script.js" ]
  out_puts = [ target_out_dir + "/test_script.abc" ]
  extra_args = [ "--module" ]
}
