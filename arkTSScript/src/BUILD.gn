import("//build/config/components/ets_frontend/es2abc_config.gni")
import("//build/ohos.gni")

# ArkTSScript 可执行文件
ohos_executable("arkTSScript") {
  output_name = "arkTSScript.bin"
  sources = [ "arkTSScript.cpp" ]

  include_dirs = [
    ".",  # 当前目录，用于包含头文件
    "//foundation/ability/ability_runtime/interfaces/inner_api/runtime/include",
    "//foundation/ability/ability_runtime/interfaces/kits/native/appkit/ability_runtime/context",
    "//foundation/ability/ability_runtime/interfaces/inner_api/app_manager/include/appmgr",
    "//foundation/appframework/eventhandler/interfaces/inner_api",
    "//foundation/appframework/eventhandler/interfaces/inner_api/event_handler",
    "//foundation/appframework/eventhandler/interfaces/inner_api/event_runner",
    "//third_party/node/src",
    "//foundation/ability/ability_runtime/interfaces/kits/native/appkit/ability_runtime/context",
    "//foundation/ability/ability_runtime/interfaces/inner_api/ability_manager/include",
  ]

  deps = [
    ":test_script_abc",
    ":test_script_js",
    "//foundation/ability/ability_runtime/interfaces/inner_api/runtime:runtime",
    "//foundation/ability/ability_runtime/frameworks/native/appkit:app_context",
    "//foundation/ability/ability_runtime/frameworks/native/appkit:app_context_utils",
    "//foundation/ability/ability_runtime/frameworks/native/runtime:runtime",
    "//foundation/appframework/eventhandler/interfaces/inner_api:eventhandler",
  ]

  external_deps = [
    "ability_base:want",
    "ability_base:base",
    "bundle_framework:appexecfwk_core",
    "bundle_framework:appexecfwk_base",
    "hilog:libhilog",
    "napi:napi",
    "resource_management:global_resmgr",
    "ipc:ipc_core",
  ]

  cflags = [
    "-Wno-unused-parameter",
    "-Wno-unused-variable",
    "-fexceptions",
  ]

  subsystem_name = "ability"
  part_name = "ability_runtime"
}

# 测试用的示例脚本
gen_js_obj("test_script_js") {
  input = "test_script.js"
  output = target_out_dir + "/test_script.o"
}

# 编译测试脚本为 ABC（需要 es2abc 工具）
# 这个 target 需要在有 es2abc 的环境中运行
es2abc_gen_abc("gen_test_script_abc") {
  src_js = rebase_path("test_script.js")
  dst_file = rebase_path(target_out_dir + "/test_script.abc")
  in_puts = [ "test_script.js" ]
  out_puts = [ target_out_dir + "/test_script.abc" ]
  extra_args = [ "--module" ]
}

# 将 ABC 文件打包
gen_js_obj("test_script_abc") {
  input = get_label_info(":gen_test_script_abc", "target_out_dir") +
          "/test_script.abc"
  output = target_out_dir + "/test_script_abc.o"
  dep = ":gen_test_script_abc"
}

# 打包组
group("arkTSScript_all") {
  deps = [ ":arkTSScript" ]
}
