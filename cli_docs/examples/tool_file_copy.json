{
  "$schema": "https://schemas.openharmony.org/cli/tool/v1",
  "name": "file-copy",
  "version": "1.0.0",
  "description": "File copy tool using positional arguments",
  "executable": "/usr/bin/cp",
  "permissions": [],

  "input": {
    "type": "object",
    "properties": {
      "source": {
        "type": "string",
        "description": "Source file or directory path"
      },
      "destination": {
        "type": "string",
        "description": "Destination path"
      },
      "recursive": {
        "type": "boolean",
        "default": false,
        "description": "Copy directories recursively"
      },
      "preserve": {
        "type": "boolean",
        "default": false,
        "description": "Preserve file attributes"
      },
      "force": {
        "type": "boolean",
        "default": false,
        "description": "Force overwrite existing files"
      },
      "verbose": {
        "type": "boolean",
        "default": false,
        "description": "Verbose output"
      }
    },
    "required": ["source", "destination"]
  },

  "argumentMapping": {
    "type": "positional",
    "order": ["source", "destination"],
    "templates": {
      "recursive": {
        "if_true": "-r",
        "if_false": ""
      },
      "preserve": {
        "if_true": "-p",
        "if_false": ""
      },
      "force": {
        "if_true": "-f",
        "if_false": ""
      },
      "verbose": {
        "if_true": "-v",
        "if_false": ""
      }
    }
  },

  "output": {
    "type": "object",
    "properties": {
      "filesCopied": {"type": "integer"},
      "bytesCopied": {"type": "integer"},
      "duration": {"type": "integer"}
    }
  },

  "timeout": 300000,
  "events": []
}
