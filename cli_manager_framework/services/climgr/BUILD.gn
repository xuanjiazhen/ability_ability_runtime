import("//build/ohos.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

config("climgr_config") {
  include_dirs = [
    "include",
    "${ability_runtime_services_path}/common/include",
  ]
  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }
}

ohos_shared_library("climgr") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  shlib_type = "sa"

  sources = [
    "src/cli_manager_service.cpp",
    "src/cli_tool_manager.cpp",
    "src/cli_tool_data_manager.cpp",
  ]

  configs = [
    ":climgr_config",
    "${ability_runtime_services_path}/common:optimize_config",
  ]

  deps = [
    "${cli_manager_framework_path}/interfaces/inner_api:cli_manager",
    "${ability_runtime_services_path}/common:app_util",
  ]

  external_deps = [
    "ability_base:want",
    "c_utils:utils",
    "eventhandler:libeventhandler",
    "hilog:libhilog",
    "ipc:ipc_core",
    "json:nlohmann_json_static",
    "kv_store:distributeddata_inner",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
  ]

  subsystem_name = "ability"
  part_name = "ability_runtime"
}

group("climgr_target") {
  deps = [
    ":climgr",
    ":cli_tools_config",
  ]
}

# Prebuild cli_tools.json to /etc/cli/
ohos_prebuilt_etc("cli_tools_config") {
  source = "${cli_manager_framework_path}/resources/cli_tools.json"
  relative_install_dir = "cli"
  subsystem_name = "ability"
  part_name = "ability_runtime"
}
