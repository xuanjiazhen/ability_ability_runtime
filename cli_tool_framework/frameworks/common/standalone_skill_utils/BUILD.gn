import("//build/ohos.gni")

config("standalone_skill_utils_config") {
  include_dirs = [ "include" ]
}

ohos_shared_library("standalone_skill_utils") {
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  sources = [ "src/standalone_skill_utils.cpp" ]

  configs = [ ":standalone_skill_utils_config" ]
  public_configs = [ ":standalone_skill_utils_config" ]

  subsystem_name = "ability"
  part_name = "ability_runtime"
}
