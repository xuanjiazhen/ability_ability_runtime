package OHOS.CliTool;

import ICliToolData;
import ICliToolManagerScheduler;
sequenceable DstbCallerInfo..OHOS.CliTool.DstbCallerInfo;
sequenceable DstbDeviceInfo..OHOS.CliTool.DstbDeviceInfo;
sequenceable CliSessionInfo..OHOS.CliTool.CliSessionInfo;
sequenceable ExecToolParam..OHOS.CliTool.ExecToolParam;
sequenceable OHOS.CliTool.ToolSummary;
sequenceable ToolInfo..OHOS.CliTool.ToolInfo;

// 分布式 CLI 工具管理接口（远端调用代理）
interface IDstbCliToolManager {
    // 获取可用设备列表
    void GetAvailableDevices([out] DstbDeviceInfo[] devices);

    // 远端工具查询
    void GetRemoteToolSummaries([in] String targetDeviceId, [out] ToolSummary[] summaries);
    void GetRemoteToolInfoByName([in] String targetDeviceId, [in] String name, [out] ToolInfo tool);

    // 远端工具执行
    void ExecToolRemote([in] String targetDeviceId, [in] ExecToolParam param,
        [in] String eventId, [in] ICliToolManagerScheduler scheduler);

    // 远端会话管理
    void SubscribeRemoteSession([in] String targetDeviceId, [in] String sessionId,
        [in] String subscriptionId, [in] ICliToolManagerScheduler scheduler);
    void UnsubscribeRemoteSession([in] String targetDeviceId, [in] String sessionId,
        [in] String subscriptionId);
    void QueryRemoteSession([in] String targetDeviceId, [in] String sessionId,
        [out] CliSessionInfo session);
    void ClearRemoteSession([in] String targetDeviceId, [in] String sessionId);
    void SendMessageRemote([in] String targetDeviceId, [in] String sessionId,
        [in] String inputText, [in] String eventId,
        [in] ICliToolManagerScheduler scheduler);
};

// 远端请求处理接口（被远端调用）
interface IDstbCliToolManagerHandler {
    // 处理远端查询请求
    void GetAllToolSummariesFromRemote([in] DstbCallerInfo callerInfo, [out] ToolSummary[] summaries);
    void GetToolInfoByNameFromRemote([in] DstbCallerInfo callerInfo, [in] String name, [out] ToolInfo tool);

    // 处理远端执行请求
    void ExecToolFromRemote([in] DstbCallerInfo callerInfo, [in] ExecToolParam param,
        [in] String eventId, [in] ICliToolManagerScheduler scheduler);

    // 处理远端会话管理请求
    void SubscribeSessionFromRemote([in] DstbCallerInfo callerInfo, [in] String sessionId,
        [in] String subscriptionId, [in] ICliToolManagerScheduler scheduler);
    void UnsubscribeSessionFromRemote([in] DstbCallerInfo callerInfo, [in] String sessionId,
        [in] String subscriptionId);
    void QuerySessionFromRemote([in] DstbCallerInfo callerInfo, [in] String sessionId,
        [out] CliSessionInfo session);
    void ClearSessionFromRemote([in] DstbCallerInfo callerInfo, [in] String sessionId);
    void SendMessageFromRemote([in] DstbCallerInfo callerInfo, [in] String sessionId,
        [in] String inputText, [in] String eventId,
        [in] ICliToolManagerScheduler scheduler);
};