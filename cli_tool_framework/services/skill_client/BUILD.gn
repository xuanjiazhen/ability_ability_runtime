import("//build/ohos.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

config("skill_client_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "include",
    "${ability_runtime_services_path}/common/include",
  ]
}

ohos_shared_library("skill_client") {
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  sources = [
    "src/skill_callback_stub_lite.cpp",
    "src/skill_execute_result.cpp",
    "src/skill_ipc_client.cpp",
  ]

  public_configs = [ ":skill_client_config" ]

  external_deps = [
    "ability_base:want",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "samgr:samgr_proxy",
  ]

  innerapi_tags = [ "platformsdk" ]
  subsystem_name = "ability"
  part_name = "ability_runtime"
}
