import("//build/ohos.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

group("cli_event_report_test") {
  testonly = true
  deps = [ ":cli_event_report_test_bin" ]
}

ohos_unittest("cli_event_report_test_bin") {
  module_name = "CliEventReportTest"
  subsystem_name = "ability"
  part_name = "ability_runtime"

  sources = [
    "cli_event_report_test.cpp",
    "${cli_tool_framework_path}/services/climgr/src/cli_event_report.cpp",
  ]

  include_dirs = [
    "//third_party/googletest/googletest/include",
    "${ability_runtime_path}/cli_tool_framework/services/climgr/include",
    "${ability_runtime_path}/cli_tool_framework/interfaces/cli_tool/include",
    "${ability_runtime_services_path}/common/include",
  ]

  deps = [
    "${ability_runtime_services_path}/common:services_common",
    "${ability_runtime_services_path}/common:hisysevent_report_static",
  ]

  external_deps = [
    "ability_base:want",
    "c_utils:utils",
    "hilog:libhilog",
    "hisysevent:libhisysevent",
  ]

  defines = [ "AMS_LOG_TAG = \"CliEventReportTest\"" ]
}
