import("//build/ohos.gni")
import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/climgr"

ohos_unittest("cli_tool_data_manager_test") {
  module_out_path = module_output_path

  include_dirs = [
    "${cli_tool_framework_path}/services/climgr/include",
    "${cli_tool_framework_path}/interfaces/cli_tool/include",
    "${ability_runtime_services_path}/common/include",
  ]

  sources = [
    "${cli_tool_framework_path}/services/climgr/src/cli_tool_data_manager.cpp",
    "cli_tool_data_manager_test.cpp",
  ]

  configs = []

  deps = [
    "${cli_tool_framework_path}/interfaces/cli_tool:cli_tool_client",
  ]

  external_deps = [
    "c_utils:utils",
    "googletest:gtest_main",
    "hilog:libhilog",
    "ipc:ipc_core",
    "kv_store:distributeddata_inner",
    "nlohmann_json:nlohmann_json",
  ]
}

group("unittest") {
  testonly = true

  deps = [ ":cli_tool_data_manager_test" ]
}
