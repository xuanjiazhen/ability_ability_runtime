import("//build/ohos.gni")

# Sample CLI tool demonstrating the cooperative cancel capability:
# - config.json declares subcommand-level supportsCancel (run: true, version: undeclared);
# - main.cpp handles SIGINT/SIGTERM via sigaction, flushes partial results and exits
#   with the recommended 128 + signal code.
# Build on demand (not wired into the product image):
#   ./build.sh --build-target cli_tool_samples
ohos_executable("ohos-timer") {
  sources = [ "src/main.cpp" ]

  cflags_cc = [ "-fvisibility=hidden" ]

  install_enable = false
  relative_install_dir = "cli_tool"

  part_name = "ability_runtime"
  subsystem_name = "ability"
}

ohos_prebuilt_etc("ohos-timer_config") {
  source = "config.json"
  relative_install_dir = "cli_tool/configs"

  part_name = "ability_runtime"
  subsystem_name = "ability"
}

group("cli_tool_samples") {
  deps = [
    ":ohos-timer",
    ":ohos-timer_config",
    "../ohos-example:ohos-example_config",
  ]
}
