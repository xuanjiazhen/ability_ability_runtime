import("//build/ohos.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

ohos_shared_library("ace_napi_hook") {
  sources = [
    "ace_napi_hook_init.cpp",
    "bytehook/bytesig.c",
    "dispatch_wrappers.cpp",
    "hook_backend.cpp",
    "module_registry_bridge.cpp",
    "symbol_table.cpp",
    "xhook/xh_core.c",
    "xhook/xh_elf.c",
    "xhook/xh_util.c",
    "xhook/xh_version.c",
    "xhook_compat.cpp",
  ]

  include_dirs = [ "." ]

  configs = [ "${ability_runtime_services_path}/common:optimize_config" ]

  external_deps = [
    "hilog:libhilog",
    "libuv:uv",
    "napi:ace_napi",
  ]

  cflags = [
    "-O2",
    "-D_FORTIFY_SOURCE=2",
  ]
  cflags_cc = cflags + [ "-std=c++17" ]

  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  branch_protector_ret = "pac_ret"

  innerapi_tags = [ "platformsdk" ]
  subsystem_name = "ability"
  part_name = "ability_runtime"
}
