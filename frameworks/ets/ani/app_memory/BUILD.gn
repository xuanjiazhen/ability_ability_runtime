import("//build/config/components/ets_frontend/ets2abc_config.gni")
import("//build/ohos.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

ohos_shared_library("app_memory_ani") {
  branch_protector_ret = "pac_ret"
  shlib_type = "ani"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    cfi_vcall_icall_only = true
    cfi_policy = "adaptive"
    debug = false
  }

  include_dirs = [
    "./include",
    "${ability_runtime_path}/frameworks/native/ability/native/ability_runtime/memory",
    "${ability_runtime_path}/frameworks/ets/ani/ani_common/include",
    "${ability_runtime_services_path}/common/include",
  ]

  configs = [ "${ability_runtime_services_path}/common:optimize_config" ]

  sources = [ "./src/ets_app_memory.cpp" ]

  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }

  deps = [
    "${ability_runtime_native_path}/ability/native/ability_runtime/memory:ability_file_page_releaser",
    "${ability_runtime_path}/frameworks/ets/ani/ani_common:ani_common",
  ]

  external_deps = [
    "access_token:libtokenid_sdk",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]

  subsystem_name = "ability"
  part_name = "ability_runtime"
}
