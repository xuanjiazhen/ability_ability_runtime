generate_static_abc("form_extension_ability") {
  base_url = "./ets"
  files = [ "./ets/@ohos.app.form.FormExtensionAbility.ets" , "./ets/FormExtensionContext.ets" ]

  is_boot_abc = "True"
  device_dst_file = "/system/framework/form_extension_ability.abc"
}

ohos_prebuilt_etc("form_extension_ability_etc") {
  source = "$target_out_dir/form_extension_ability.abc"
  deps = [ ":form_extension_ability" ]
  module_install_dir = "framework"
  subsystem_name = "ability"
  part_name = "form_fwk"
}
