import("//build/ohos.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

ohos_shared_library("abc_runner_napi") {
  sources = [
    "js_abc_runner.cpp",
    "native_module.cpp",
  ]

  include_dirs = [
    "${ability_runtime_path}/interfaces/inner_api/ability_manager/include",
    "${ability_runtime_path}/interfaces/inner_api/app_manager/include",
    "${ability_runtime_path}/frameworks/native/ability/native",
    "${ability_runtime_path}/frameworks/native/appkit/ability_runtime/context",
  ]

  deps = [
    "${ability_runtime_path}/frameworks/js/napi/app:app_napi",
    "${ability_runtime_path}/interfaces/inner_api/ability_manager:ability_manager",
    "${ability_runtime_path}/interfaces/inner_api/app_manager:app_manager",
  ]

  external_deps = [
    "ability_base:want",
    "ability_runtime:abilitykit_native",
    "ability_runtime:appkit_native",
    "c_utils:utils",
    "hilog:libhilog",
    "hitrace:hitrace_meter",
    "ipc:ipc_core",
    "napi:libnapi",
    "samgr:samgr_proxy",
  ]

  subsystem_name = "ability"
  part_name = "ability_runtime"
}
