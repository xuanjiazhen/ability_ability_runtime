import("//build/ohos.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

template("climanager") {
  ohos_shared_library(target_name) {
    forward_variables_from(invoker, [ "relative_install_dir" ])

    configs = [ "${ability_runtime_services_path}/common:optimize_config" ]

    sources = [
      "cli_manager_module.cpp",
      "js_cli_manager.cpp",
      "js_cli_manager_utils.cpp",
    ]

    include_dirs = [
      "./",
      "${ability_runtime_services_path}/common/include",
    ]

    deps = [
      "${ability_runtime_innerkits_path}/cli_manager:cli_manager",
      "${ability_runtime_napi_path}/inner/napi_common:napi_common",
      "${ability_runtime_native_path}/ability/native:ability_business_error",
      "${ability_runtime_services_path}/common:app_util",
    ]

    external_deps = [
      "ability_base:base",
      "c_utils:utils",
      "hilog:libhilog",
      "ipc:ipc_core",
      "napi:ace_napi",
    ]

    subsystem_name = "ability"
    part_name = "ability_runtime"
  }
}

climanager("climanager_napi") {
  relative_install_dir = "module/application"
}

climanager("climanager") {
  relative_install_dir = "module/app/ability"
  defines = [ "ENABLE_ERRCODE" ]
}
