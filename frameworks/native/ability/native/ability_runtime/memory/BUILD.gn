import("//build/ohos.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

config("file_page_releaser_public_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "${ability_runtime_path}/frameworks/native/ability/native/ability_runtime/memory",
    "${ability_runtime_path}/interfaces/kits/native/appkit/ability_bundle_manager_helper",
    "${ability_runtime_services_path}/common/include",
  ]
  defines = [ "AMS_LOG_TAG = \"FilePageReleaser\"" ]
  defines += [ "AMS_LOG_DOMAIN = 0xD001300" ]
}

ohos_shared_library("ability_file_page_releaser") {
  branch_protector_ret = "pac_ret"

  sanitize = {
    cfi = true
    cfi_cross_dso = true
    cfi_vcall_icall_only = true
    debug = false
  }

  sources = [ "file_page_releaser.cpp" ]

  configs = [
    ":file_page_releaser_public_config",
    "${ability_runtime_services_path}/common:optimize_config",
  ]

  public_configs = [ ":file_page_releaser_public_config" ]

  deps = [
    # runtime provides the compiled BundleMgrHelper symbol + bundle framework IPC wiring
    "${ability_runtime_innerkits_path}/runtime:runtime",
    "${ability_runtime_native_path}/ability/native/ability_runtime/madvise:ability_madvise",
    "${ability_runtime_services_path}/common:app_util",
  ]

  external_deps = [
    "bundle_framework:appexecfwk_base", # BundleInfo / HapModuleInfo types
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]

  subsystem_name = "ability"
  part_name = "ability_runtime"
}
