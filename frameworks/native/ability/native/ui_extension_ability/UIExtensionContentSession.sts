export default class UIExtensionContentSession {
    static { loadLibrary("ui_extension") }
    public native terminateSelfSync(): void
    public terminateSelf(callback:() => void):void{
    console.log("call terminateSelf callback 111");
    let p1 = taskpool.execute(this.terminateSelfSync);
        p1.then((e :NullishType)=>{
        callback();
        });
        console.log("call terminateSelf callback 333");
    }
}

function main(){
    let uiExtensionContentSession = new UIExtensionContentSession;
    console.log("terminateSelf start.");
    uiExtensionContentSession.terminateSelf(() => {
        console.log("terminateSelf 111.");
    });
    console.log("terminateSelf end.");
}