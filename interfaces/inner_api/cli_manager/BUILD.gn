import("//build/ohos.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

group("cli_manager") {
  deps = [ ":cli_manager_inner" ]
}

config("cli_manager_public_config") {
  visibility = [ ":*" ]
  visibility += [
    "${ability_runtime_innerkits_path}/cli_tool_registry/*",
  ]

  include_dirs = [
    "include",
    "${ability_runtime_services_path}/climgr/include",
  ]
}

ohos_shared_library("cli_manager_inner") {
  branch_protector_ret = "pac_ret"

  include_dirs = [
    "${ability_runtime_services_path}/common/include",
    "${ability_runtime_services_path}/climgr/include",
  ]

  sources = [
    "cli_manager_proxy.cpp",
    "cli_callback_proxy.cpp",
    "cli_callback_stub.cpp",
  ]

  public_configs = [ ":cli_manager_public_config" ]
  configs = [ "${ability_runtime_services_path}/common:optimize_config" ]

  deps = [
    "${ability_runtime_innerkits_path}/error_utils:ability_runtime_error_util",
    "${ability_runtime_services_path}/common:app_util",
  ]

  external_deps = [
    "ability_base:configuration",
    "ability_base:want",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
  ]

  subsystem_name = "ability"
  part_name = "ability_runtime"
}
