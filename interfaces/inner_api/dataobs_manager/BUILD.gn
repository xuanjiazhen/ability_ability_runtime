import("//build/ohos.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

config("dataobs_manager_public_config") {
  visibility = [ ":*" ]
  visibility += [ "${ability_runtime_test_path}/fuzztest/*" ]
  include_dirs = [
    "include/",
    "${ability_runtime_path}/interfaces/kits/native/ability/native",
    "${ability_runtime_services_path}/dataobsmgr/include",
  ]
  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }
}

ohos_shared_library("dataobs_manager") {
  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    cfi_policy = "adaptive"
    debug = false
  }
  sources = [
    "${ability_runtime_services_path}/dataobsmgr/src/data_ability_observer_proxy.cpp",
    "${ability_runtime_services_path}/dataobsmgr/src/data_ability_observer_stub.cpp",
    "${ability_runtime_services_path}/dataobsmgr/src/dataobs_mgr_changeinfo.cpp",
    "${ability_runtime_services_path}/dataobsmgr/src/dataobs_mgr_client.cpp",
    "${ability_runtime_services_path}/dataobsmgr/src/dataobs_mgr_proxy.cpp",
  ]

  public_configs = [
    ":dataobs_manager_public_config",
    "${ability_runtime_services_path}/dataobsmgr:dataobsms_config",
  ]

  configs = [ "${ability_runtime_services_path}/common:optimize_config" ]

  deps = []

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "samgr:samgr_proxy",
  ]
  public_external_deps = [ "ability_base:zuri" ]
  innerapi_tags = [
    "platformsdk",
    "sasdk",
  ]
  subsystem_name = "ability"
  part_name = "ability_runtime"
  sources += [ "src/native_uri_lazy.cpp" ]
  ldflags = [
    "-Wl,--wrap=_ZN4OHOS3UriC1EOS0_",
    "-Wl,--wrap=_ZN4OHOS3UriC1ERKNSt3__h12basic_stringIcNS1_11char_traitsIcEENS1_9allocatorIcEEEE",
    "-Wl,--wrap=_ZN4OHOS3UriC1ERKS0_",
    "-Wl,--wrap=_ZN4OHOS3UriD1Ev",
    "-Wl,--wrap=_ZNK4OHOS3Uri8ToStringEv",
    "-Wl,--wrap=_ZNK4OHOS3UrieqERKS0_",
  ]
}
