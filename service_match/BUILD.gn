import("//build/ohos.gni")

config("pageconfig_config") {
  include_dirs = [
    "include",
    "../utils/include/",
  ]
}

ohos_shared_library("hmos_pageconfig") {
  branch_protector_ret = "pac_ret"
  sources = [
      "src/page_scaling_manager.cpp",
      "../utils/src/page_data_manager.cpp",
  ]

  public_configs = [":pageconfig_config"]

  include_dirs = [
      "include/",
      "../utils/",
  ]

  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
    cfi_vcall_icall_only = true
  }

  defines = []
  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }
  if (target_cpu == "arm64") {
    defines += [ "_ARM64_" ]
  }

  cflags_cc = [
    "-Oz",
    "-fno-unwind-tables",
    "-fdata-sections",
    "-ffunction-sections",
    "-fno-asynchronous-unwind-tables",
    "-fvisibility-inlines-hidden",
    "-flto",
  ]

  external_deps = [
    "ace_engine:ace_uicontent",
    "c_utils:utils",
    "json:nlohmann_json_static",
    "hilog:libhilog",
    "window_manager:libwm",
    "sensor:sensor_interface_native",
    "data_share:datashare_consumer",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
    "ipc:ipc_single",
  ]

  subsystem_name = "ability_runtime"
  part_name = "service_match"
}