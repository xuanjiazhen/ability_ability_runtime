    async getPhoneShowHapList() {
        const lineNums = 8;
        let showHapList = [];
        let phoneShowHapList = [];
        let jsonIconMap = new Map();
        for (let i = 1; i <= globalThis.params.hapList.length; i++) {
            console.info(TAG, 'hapList[' + (i - 1).toString() + ']: ' + JSON.stringify(globalThis.params.hapList[i - 1]));
