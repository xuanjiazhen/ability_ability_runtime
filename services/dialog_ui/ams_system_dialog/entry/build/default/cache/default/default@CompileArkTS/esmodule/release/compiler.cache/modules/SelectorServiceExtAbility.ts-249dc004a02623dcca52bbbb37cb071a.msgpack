            }
            catch (error) {
                console.error(TAG, 'display getDefaultDisplay callback failed: ' + JSON.stringify(error));
            }
        });
    }
    onDestroy() {
        console.info(TAG, 'SelectorServiceExtensionAbility onDestroy.');
        if (win !== undefined) {
            win.destroy();
