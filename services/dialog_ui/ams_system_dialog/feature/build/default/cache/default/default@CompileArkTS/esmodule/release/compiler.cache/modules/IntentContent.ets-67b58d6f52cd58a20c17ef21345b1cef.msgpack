import { TAG, DOMAIN } from '../pages/Index';
import bundle from '@ohos.bundle.bundleManager';
export class IntentContent extends ViewPU {
    constructor(parent, params, __localStorage, elmtId = -1, paramsLambda = undefined, extraInfo) {
        super(parent, __localStorage, elmtId, extraInfo);
        if (typeof paramsLambda === "function") {
            this.paramsGenerator_ = paramsLambda;
        }
        this.__articlePathStack = this.initializeConsume('articlePathStack', "articlePathStack");
        this.scroller = new Scroller();
        this.__listMaterial = new ObservedPropertyObjectPU(null, this, "listMaterial");
        this.__intermediateGroupMaterial = new ObservedPropertyObjectPU({}, this, "intermediateGroupMaterial");
        this.__groupMaterial = new ObservedPropertyObjectPU({}, this, "groupMaterial");
        this.context = this.getUIContext().getHostContext();
        this.__pixelMap = new ObservedPropertyObjectPU(undefined, this, "pixelMap");
        this.setInitiallyProvidedValue(params);
        this.finalizeConstruction();
    }
    setInitiallyProvidedValue(params) {
        if (params.scroller !== undefined) {
            this.scroller = params.scroller;
        }
        if (params.listMaterial !== undefined) {
            this.listMaterial = params.listMaterial;
        }
        if (params.intermediateGroupMaterial !== undefined) {
            this.intermediateGroupMaterial = params.intermediateGroupMaterial;
        }
        if (params.groupMaterial !== undefined) {
            this.groupMaterial = params.groupMaterial;
        }
        if (params.context !== undefined) {
            this.context = params.context;
        }
        if (params.pixelMap !== undefined) {
            this.pixelMap = params.pixelMap;
        }
    }
    updateStateVars(params) {
    }
    purgeVariableDependenciesOnElmtId(rmElmtId) {
        this.__articlePathStack.purgeDependencyOnElmtId(rmElmtId);
        this.__listMaterial.purgeDependencyOnElmtId(rmElmtId);
        this.__intermediateGroupMaterial.purgeDependencyOnElmtId(rmElmtId);
        this.__groupMaterial.purgeDependencyOnElmtId(rmElmtId);
        this.__pixelMap.purgeDependencyOnElmtId(rmElmtId);
    }
    aboutToBeDeleted() {
        this.__articlePathStack.aboutToBeDeleted();
        this.__listMaterial.aboutToBeDeleted();
        this.__intermediateGroupMaterial.aboutToBeDeleted();
        this.__groupMaterial.aboutToBeDeleted();
        this.__pixelMap.aboutToBeDeleted();
        SubscriberManager.Get().delete(this.id__());
        this.aboutToBeDeletedInternal();
    }
    get articlePathStack() {
        return this.__articlePathStack.get();
    }
    set articlePathStack(newValue) {
        this.__articlePathStack.set(newValue);
    }
    get listMaterial() {
        return this.__listMaterial.get();
    }
    set listMaterial(newValue) {
        this.__listMaterial.set(newValue);
    }
