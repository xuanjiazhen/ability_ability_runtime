{
	"app": {
		"bundleName": "com.ohos.amsdialog",
		"vendor": "example",
		"versionCode": 1000018,
		"versionName": "1.6.8",
		"icon": "$media:app_title_icon",
		"label": "$string:app_name",
		"distributedNotificationEnabled": true,
		"minAPIVersion": 9,
		"targetAPIVersion": 26,
		"apiReleaseType": "Canary1",
		"compileSdkVersion": "26.1.0.25",
		"compileSdkType": "OpenHarmony",
		"targetMinorAPIVersion": 0,
		"targetPatchAPIVersion": 0,
		"appEnvironments": [],
		"bundleType": "app",
		"buildMode": "release",
		"debug": false
	},
	"module": {
		"name": "default",
		"type": "feature",
		"description": "$string:module_desc",
		"mainElement": "EntryAbility",
		"requestPermissions": [
			{
				"name": "ohos.permission.START_ABILITIES_FROM_BACKGROUND"
			},
			{
				"name": "ohos.permission.ABILITY_BACKGROUND_COMMUNICATION"
			},
			{
				"name": "ohos.permission.EXECUTE_INSIGHT_INTENT"
			},
			{
				"name": "ohos.permission.GET_BUNDLE_INFO_PRIVILEGED"
			},
			{
				"name": "ohos.permission.START_INVISIBLE_ABILITY"
			},
			{
				"name": "ohos.permission.REQUIRE_FORM"
			},
			{
				"name": "ohos.permission.MANAGE_SECURE_SETTINGS"
			}
		],
		"deviceTypes": [
			"default"
		],
		"metadata": [
			{
				"name": "support_debug_intents"
			}
		],
		"deliveryWithInstall": true,
		"installationFree": false,
		"pages": "$profile:main_pages",
		"abilities": [
			{
				"name": "EntryAbility",
				"srcEntry": "./ets/entryability/EntryAbility.ets",
				"description": "$string:EntryAbility_desc",
				"icon": "$media:layered_image",
				"label": "$string:Detail_title_ytts",
				"startWindowIcon": "$media:startIcon",
				"startWindowBackground": "$color:start_window_background",
				"exported": true
			}
		],
		"packageName": "default"
	}
}
