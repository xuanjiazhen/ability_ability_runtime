import("//build/ohos.gni")

ohos_hap("intent_debug_app_hap") {
  hap_profile = "products/default/src/main/module.json"

  deps = [
    ":intent_debug_app_products_js_assets",
    ":intent_debug_app_products_resources",
    ":intent_debug_app_features_js_assets",
    ":intent_debug_app_features_resources"
  ]

  certificate_profile = "signature/openharmony_sx.p7b"
  hap_name = "intent_debug_app"
  subsystem_name = "ability"
  part_name = "ability_runtime"
  module_install_dir = "app/com.ohos.amsdialog"
  publicity_file = "publicity.xml"
}

ohos_js_assets("intent_debug_app_products_js_assets") {
  hap_profile = "products/default/src/main/module.json"
  ets2abc = true
  source_dir = "products/default/src/main/ets"
}

ohos_js_assets("intent_debug_app_features_js_assets") {
  hap_profile = "features/intent/main/module.json"
  ets2abc = true
  source_dir = "features/intent/src/main/ets"
}

ohos_app_scope("intent_debug_app_app_profile") {
  app_profile = "AppScope/app.json"
  sources = [ "AppScope/resources" ]
}

ohos_resources("intent_debug_app_products_resources") {
  sources = [ "products/default/src/main/resources" ]
  deps = [ ":intent_debug_app_app_profile" ]
  hap_profile = "entry/src/main/module.json"
}

ohos_resources("intent_debug_app_features_resources") {
  sources = [ "features/intent/main/resources" ]
  deps = [ ":intent_debug_app_app_profile" ]
  hap_profile = "entry/src/main/module.json"
}

group("intent_hap") {
  deps = [ ":intent_debug_app_hap" ]
}
