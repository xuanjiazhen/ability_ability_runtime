import("../../../../test/fuzztest/unittest_fuzz.gni")

module_output = "insightintenteventmgr_fuzzer"
module_test_output = "insightintenteventmgr_fuzzer"

ohos_fuzztest("${module_test_output}") {
  module_out_path = module_output

  fuzz_config_file = "${module_test_output}.fuzz.config"
  fuzz_config_file_dir = "."
  src_out_dir = "../../../../"

  sources = [ "insightintenteventmgr_fuzzer.cpp" ]

  configs = [
    "${ability_runtime_root_path}/test/fuzztest:test_fuzz_config",
    "${ability_runtime_root_path}/test/fuzztest:security_fuzz_config",
  ]

  deps = [
    "${ability_runtime_services_path}/abilitymgr:abilityms",
    "${ability_runtime_interfaces_path}/inner_api/ability_manager:ability_manager_internal",
  ]

  external_deps = [
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "c_utils:c_utils",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]
}

group("${module_test_output}") {
  testonly = true
  deps = [ ":${module_test_output}" ]
}
