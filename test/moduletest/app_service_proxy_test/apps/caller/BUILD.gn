import("//build/ohos.gni")

ohos_app("caller_hap") {
  deps = [ "../../:test_sdk" ]
  sdk_home = "$root_out_dir/app_service_test_sdk"
  install_enable = false
  certificate_profile = "signature/profile.p7b"
  hap_name = "app_service_caller"
  hap_out_dir = "$root_out_dir/tests/moduletest/ability_runtime/ability_runtime/app_service/resource"
  subsystem_name = "ability"
  part_name = "ability_runtime"
  js_build_mode = "release"
  assemble_type = "assembleHap"
  build_level = "module"
  build_modules = [ "entry" ]
}
