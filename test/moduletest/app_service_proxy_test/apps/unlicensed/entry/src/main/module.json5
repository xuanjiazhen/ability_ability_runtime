{
  "module": {
    "name": "entry",
    "type": "entry",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "default",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/EntryAbility.ets",
        "exported": true,
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_background"
      }
    ],
    "requestPermissions": [],
    "extensionAbilities": [
      {
        "name": "Service",
        "srcEntry": "./ets/Provider.ets",
        "type": "appService",
        "exported": true,
        "appIdentifierAllowList": [
          "appservice-proxy-caller",
          "appservice-proxy-denied"
        ]
      },
      {
        "name": "HiddenService",
        "srcEntry": "./ets/Provider.ets",
        "type": "appService",
        "exported": false,
        "appIdentifierAllowList": [
          "appservice-proxy-caller",
          "appservice-proxy-denied"
        ]
      },
      {
        "name": "ProtectedService",
        "srcEntry": "./ets/Provider.ets",
        "type": "appService",
        "exported": true,
        "appIdentifierAllowList": [
          "appservice-proxy-caller",
          "appservice-proxy-denied"
        ],
        "permissions": [
          "ohos.permission.INTERNET"
        ]
      },
      {
        "name": "RestrictedService",
        "srcEntry": "./ets/Provider.ets",
        "type": "appService",
        "exported": true,
        "appIdentifierAllowList": [
          "appservice-proxy-caller"
        ]
      }
    ]
  }
}
