import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/uripermmgr"

copy("uripermmgr_copy") {
  sources = [
    "${ability_runtime_path}/services/uripermmgr/src/file_uri_distribution_utils.cpp",
    "${ability_runtime_path}/services/uripermmgr/src/tokenid_permission.cpp",
    "${ability_runtime_path}/services/uripermmgr/src/media_permission_manager.cpp",
    "${ability_runtime_path}/services/uripermmgr/src/batch_uri.cpp",
    "${ability_runtime_path}/services/uripermmgr/include/file_uri_distribution_utils.h",
    "${ability_runtime_path}/services/uripermmgr/include/tokenid_permission.h",
    "${ability_runtime_path}/services/uripermmgr/include/media_permission_manager.h",
    "${ability_runtime_path}/services/uripermmgr/include/batch_uri.h",
    "${ability_runtime_path}/services/uripermmgr/include/check_result.h",
    "${ability_runtime_path}/services/uripermmgr/include/fud_constants.h",
    "${ability_runtime_path}/services/uripermmgr/include/upms_policy_info.h",
  ]
  outputs = [ "${target_gen_dir}/services/uripermmgr/src/{{source_file_part}}" ]
}

ohos_unittest("uripermmgr_unit_test") {
  module_out_path = module_output_path

  include_dirs = [
    "${target_gen_dir}/services/uripermmgr/src",
    "${ability_runtime_path}/services/uripermmgr/include",
    "${ability_runtime_path}/services/common/include",
    "${ability_runtime_path}/interfaces/inner_api/uri_permission",
    "../../mock_utils",
    "mock/include",
    "mock",
  ]

  sources = [
    "${target_gen_dir}/services/uripermmgr/src/file_uri_distribution_utils.cpp",
    "${target_gen_dir}/services/uripermmgr/src/tokenid_permission.cpp",
    "${target_gen_dir}/services/uripermmgr/src/media_permission_manager.cpp",
    "${target_gen_dir}/services/uripermmgr/src/batch_uri.cpp",
  ]

  sources += [
    "src/tokenid_permission_test.cpp",
    "src/file_uri_distribution_utils_test.cpp",
    "src/media_permission_manager_test.cpp",
    "src/batch_uri_test.cpp",
  ]

  deps = [ ":uripermmgr_copy" ]

  external_deps = [
    "ability_base:configuration",
    "ability_base:kvstore",
    "ability_base:want",
    "bundle_framework:appexecfwk_base",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "ffrt:libffrt",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
    "ipc:ipc_core",
    "json:nlohmann_json_static",
    "samgr:samgr_proxy",
  ]

  defines = [
    "ABILITY_RUNTIME_FEATURE_SANDBOXMANAGER",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":uripermmgr_unit_test" ]
}
