import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/uripermmgr"

copy("batch_uri_copy") {
  sources = [
    "${ability_runtime_path}/services/uripermmgr/src/batch_uri.cpp",
    "${ability_runtime_path}/services/uripermmgr/include/batch_uri.h",
    "${ability_runtime_path}/services/uripermmgr/include/check_result.h",
    "${ability_runtime_path}/services/uripermmgr/include/fud_constants.h",
    "${ability_runtime_path}/services/uripermmgr/include/upms_policy_info.h",
    "${ability_runtime_path}/services/common/include/hilog_tag_wrapper.h",

  ]
  outputs = [ "${target_gen_dir}/services/uripermmgr/src/{{source_file_part}}" ]
}

ohos_unittest("batch_uri_unit_test") {
  module_out_path = module_output_path

  include_dirs = [
    "${target_gen_dir}/services/uripermmgr/src",
    "../../../mock_utils",
    # Mock dependencies
    "../../../mock/upms/uripermmgr/file_permission_manager",
    "../../../mock/new_security/sandbox_manager_kit",
    "../../../mock/permission_verification",
  ]

  sources = [
    "${target_gen_dir}/services/uripermmgr/src/batch_uri.cpp",
    "batch_uri_test.cpp",
  ]

  defines = []
  if (ability_runtime_feature_sandboxmanager) {
    defines += [ "ABILITY_RUNTIME_FEATURE_SANDBOXMANAGER" ]
  }

  if (ability_runtime_media_library_enable) {
    defines += [ "ABILITY_RUNTIME_MEDIA_LIBRARY_ENABLE" ]
  }

  if (ability_runtime_udmf_enable) {
    defines += [ "ABILITY_RUNTIME_UDMF_ENABLE" ]
  }

  deps = [ ":batch_uri_copy" ]

  external_deps = [
    "ability_base:want",
    "ability_base:zuri",
    "c_utils:utils",
    "ffrt:libffrt",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":batch_uri_unit_test" ]
}
