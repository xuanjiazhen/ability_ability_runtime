import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/uripermmgr"

copy("upms_udmf_utils_copy") {
  sources = [
    "${ability_runtime_path}/services/uripermmgr/src/upms_udmf_utils.cpp",
    "${ability_runtime_path}/services/uripermmgr/include/upms_udmf_utils.h",
    "${ability_runtime_path}/interfaces/inner_api/ability_manager/include/ability_manager_errors.h",
    "${ability_runtime_path}/services/common/include/in_process_call_wrapper.h",
    "${ability_runtime_path}/services/common/include/hilog_tag_wrapper.h",
  ]
  outputs = [ "${target_gen_dir}/services/uripermmgr/src/{{source_file_part}}" ]
}

ohos_unittest("upms_udmf_utils_unit_test") {
  module_out_path = module_output_path

  include_dirs = [
    "${target_gen_dir}/services/uripermmgr/src",
    "../../../mock_utils",
    "../../../mock/ipc_skeleton",
    "../../../mock/upms/uripermmgr/file_uri_distribution_utils",
    "../../../mock/udmf",
    "../../../mock/hitrace_meter",
  ]

  sources = [
    "${target_gen_dir}/services/uripermmgr/src/upms_udmf_utils.cpp",
    "upms_udmf_utils_test.cpp",
  ]

  deps = [ ":upms_udmf_utils_copy" ]

  external_deps = [
    "ability_base:zuri",
    "c_utils:utils",
    "ffrt:libffrt",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":upms_udmf_utils_unit_test" ]
}
