import("//build/ohos.gni")
import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

ohos_unittest("agent_record_test") {
  module_out_path = "ability_runtime/ability_runtime/agent_runtime/agent_record_test"

  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
    blocklist = "../../../cfi_blocklist.txt"
  }

  sources = [
    "agent_record_test.cpp",
    "${agent_runtime_framework_path}/services/agentmgr/src/agent_base_record.cpp",
    "${agent_runtime_framework_path}/services/agentmgr/src/agent_low_code_record.cpp",
    "${agent_runtime_framework_path}/services/agentmgr/src/agent_standard_record.cpp",
  ]

  include_dirs = [
    "${ability_runtime_innerkits_path}/ability_manager/include",
    "${ability_runtime_innerkits_path}/app_manager/include/appmgr",
    "${ability_runtime_path}/interfaces/kits/native/ability/native",
    "${ability_runtime_path}/utils/global/constant",
    "${ability_runtime_services_path}/abilitymgr/include",
    "${ability_runtime_services_path}/common/include",
    "${agent_runtime_framework_path}/interfaces/kits/native/agent_extension/connection/include",
    "${agent_runtime_framework_path}/services/agentmgr/include",
    "${agent_runtime_framework_path}/services/common/include",
  ]

  deps = [
    "${ability_runtime_innerkits_path}/ability_manager:ability_connect_callback_stub",
    "${agent_runtime_framework_path}/interfaces/kits/native/agent_extension/connection:agent_extension_connection",
  ]

  external_deps = [
    "ability_base:want",
    "c_utils:utils",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":agent_record_test" ]
}
