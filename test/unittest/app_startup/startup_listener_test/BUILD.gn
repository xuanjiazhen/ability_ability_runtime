import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/app_startup"

copy("startup_listener_test_inc_copy") {
  sources = [ "${ability_runtime_path}/interfaces/kits/native/appkit/app_startup/startup_listener.h" ]
  outputs = [ "${target_gen_dir}/include/startup_listener.h" ]
}

ohos_unittest("StartupListenerTest") {
  module_out_path = module_output_path

  include_dirs = [
    "${target_gen_dir}/include",
    "${ability_runtime_test_path}/mock/mock_app_startup/mock_startup_task_result",
    "${ability_runtime_path}/interfaces/kits/native/appkit/app_startup",
    "${ability_runtime_path}/interfaces/kits/native/ability/native"
  ]

  sources = [
    "startup_listener_test.cpp",
    "${ability_runtime_native_path}/appkit/app_startup/startup_listener.cpp"
  ]

  deps = [
    ":startup_listener_test_inc_copy",
  ]

  external_deps = [
    "c_utils:utils",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":StartupListenerTest" ]
}
