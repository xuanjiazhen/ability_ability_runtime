import("//build/ohos.gni")
import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

ohos_shared_library("appkit_child_fake") {
  testonly = true
  module_out_path = "ability_runtime/ability_runtime/appkit"
  output_name = "appkit_child"

  sources = [ "fake_child_main_thread_entry.cpp" ]

  subsystem_name = "ability"
  part_name = "ability_runtime"
}

ohos_unittest("child_process_api_test") {
  module_out_path = "ability_runtime/ability_runtime/appkit"

  sources = [ "child_process_api_test.cpp" ]

  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }

  deps = [
    ":appkit_child_fake",
    "${ability_runtime_native_path}/appkit:appkit_child_entry",
  ]

  external_deps = [
    "googletest:gmock_main",
    "googletest:gtest_main",
  ]

  defines = []
  if (ability_runtime_child_process) {
    defines += [ "SUPPORT_CHILD_PROCESS" ]
  }
}

group("unittest") {
  testonly = true
  deps = [ ":child_process_api_test" ]
}
