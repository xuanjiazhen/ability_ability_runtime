import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/abilitymgr"

if (ability_runtime_relational) {
  ohos_unittest("napi_data_ability_predicates_test") {
    module_out_path = module_output_path

    sources = [
      "${ability_runtime_napi_path}/featureAbility/data_ability/js_utils.cpp",
      "${ability_runtime_napi_path}/featureAbility/data_ability/napi_data_ability_predicates.cpp",
      "${ability_runtime_napi_path}/featureAbility/data_ability/napi_rdb_js_utils.cpp",
      "napi_data_ability_predicates_test.cpp",
    ]

    include_dirs = [
      "${ability_runtime_napi_path}/featureAbility/data_ability/include",
    ]

    deps = [
      "${ability_runtime_innerkits_path}/ability_manager:ability_manager",
      "${ability_runtime_innerkits_path}/dataobs_manager:dataobs_manager",
      "${ability_runtime_innerkits_path}/runtime:runtime",
      "${ability_runtime_napi_path}/inner/napi_common:napi_common",
      "${ability_runtime_native_path}/ability/native:abilitykit_native",
      "${ability_runtime_native_path}/appkit:appkit_native",
      "${ability_runtime_path}/js_environment/frameworks/js_environment:js_environment",
    ]

    external_deps = [
      "ability_base:want",
      "ability_base:zuri",
      "access_token:libaccesstoken_sdk",
      "bundle_framework:appexecfwk_base",
      "c_utils:utils",
      "common_event_service:cesfwk_innerkits",
      "data_share:datashare_common_lite",
      "ets_runtime:libark_jsruntime",
      "eventhandler:libeventhandler",
      "googletest:gtest_main",
      "hilog:libhilog",
      "hitrace:hitrace_meter",
      "ipc:ipc_core",
      "kv_store:distributeddata_mgr",
      "libuv:uv",
      "napi:ace_napi",
      "relational_store:native_appdatafwk",
      "relational_store:native_dataability",
      "relational_store:native_rdb",
      "relational_store:rdb_data_share_adapter",
    ]
  }
}

group("unittest") {
  testonly = true
  deps = []
  if (ability_runtime_relational) {
    deps += [ ":napi_data_ability_predicates_test" ]
  }
}
