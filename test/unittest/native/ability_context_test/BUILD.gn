import("//build/ohos.gni")

ohos_unittest("ability_context_test") {
  module_out_path = module_output_path
  sources = [
    "ability_context_test.cpp",
  ]

  include_dirs = [
    "//foundation/ability/ability_runtime/interfaces/kits/native/ability/ability_runtime",
    "//foundation/ability/ability_runtime/interfaces/innerkits/include",
    "//base/ability/ability_runtime/interfaces/innerkits/include",
  ]

  deps = [
    "//foundation/ability/ability_runtime/interfaces/kits/native/ability/ability_runtime:ability_context_impl",
    "//third_party/googletest:gtest_main",
  ]

  cflags = [
    "-Wall",
    "-Wextra",
    "-Werror",
  ]

  install_enable = true
  part_name = "ability_runtime"
}