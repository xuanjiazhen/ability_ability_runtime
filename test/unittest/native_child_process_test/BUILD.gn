import("//build/ohos.gni")
import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/native_runtime"

ohos_unittest("native_child_process_test") {
  module_out_path = module_output_path
  include_dirs = [ "${ability_runtime_native_path}/child_process/include" ]

  sources = [ "native_child_process_test.cpp" ]
  configs = [ "${ability_runtime_services_path}/common:common_config" ]
  public_configs = []

  deps = [
    "${ability_runtime_innerkits_path}/app_manager:app_manager",
    "${ability_runtime_innerkits_path}/child_process_manager:child_process_manager",
    "${ability_runtime_native_path}/ability/native:ability_business_error",
    "${ability_runtime_native_path}/child_process:child_process",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_capi",
    "ipc:ipc_core",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":native_child_process_test" ]
}
