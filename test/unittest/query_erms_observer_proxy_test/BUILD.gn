import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/abilitymgr"

ohos_unittest("query_erms_observer_proxy_test") {
  module_out_path = module_output_path
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
    blocklist = "../../cfi_blocklist.txt"
  }

  include_dirs = [
    "mock",
    "${ability_runtime_test_path}/new_test/mock/message_parcel",
    "${ability_runtime_test_path}/new_test/mock/iremote_object",
    "${ability_runtime_test_path}/new_test/mock/iremote_broker",
    "${ability_runtime_test_path}/new_test/mock/iremote_stub",
    "${ability_runtime_test_path}/new_test/mock/message_option",
    "${ability_runtime_test_path}/new_test/mock/hilog_tag_wrapper",
    "${ability_runtime_test_path}/new_test/mock_utils",
    "${ability_runtime_path}/interfaces/kits/native/ability/native",
    "${ability_runtime_path}/interfaces/inner_api/ability_manager/include",
  ]

  sources = [
    "${ability_runtime_path}/frameworks/native/ability/native/query_erms_observer_proxy.cpp",
    "query_erms_observer_proxy_test.cpp",
  ]

  configs = [ "${ability_runtime_innerkits_path}/ability_manager:ability_manager_public_config" ]

  deps = []

  external_deps = [
    "c_utils:utils",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":query_erms_observer_proxy_test" ]
}
