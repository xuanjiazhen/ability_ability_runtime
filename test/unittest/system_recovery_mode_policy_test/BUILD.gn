import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/common"

ohos_unittest("system_recovery_mode_policy_test") {
  module_out_path = module_output_path

  include_dirs = [
    "mock",
    "${ability_runtime_services_path}/common/include",
    "${ability_runtime_services_path}/system_recovery/include",
  ]

  sources = [
    "${ability_runtime_services_path}/system_recovery/src/system_recovery_mode_policy.cpp",
    "system_recovery_mode_policy_test.cpp",
  ]

  external_deps = [
    "c_utils:utils",
    "googletest:gtest_main",
    "json:nlohmann_json_static",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":system_recovery_mode_policy_test" ]
}
