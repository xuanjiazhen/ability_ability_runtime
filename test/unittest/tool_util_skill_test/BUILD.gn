import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

module_output_path = "ability_runtime/ability_runtime/cli_tool"

ohos_unittest("tool_util_skill_test") {
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
    blocklist = "../../cfi_blocklist.txt"
  }
  branch_protector_ret = "pac_ret"
  module_out_path = module_output_path

  include_dirs = [
    "${cli_tool_framework_path}/services/climgr/include",
    "${cli_tool_framework_path}/interfaces/cli_tool/include",
    "${cli_tool_framework_path}/services/common/include",
    "${ability_runtime_services_path}/common/include",
  ]

  sources = [ "tool_util_skill_test.cpp" ]

  configs = [
    "${cli_tool_framework_path}/services/climgr:clisa_config",
  ]

  deps = [
    "${ability_runtime_innerkits_path}/ability_manager:ability_manager",
    "${cli_tool_framework_path}/interfaces/cli_tool:cli_tool_client",
  ]

  external_deps = [
    "ability_base:want",
    "c_utils:utils",
    "googletest:gtest_main",
    "hilog:libhilog",
    "ipc:ipc_core",
    "json:nlohmann_json_static",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":tool_util_skill_test" ]
}
