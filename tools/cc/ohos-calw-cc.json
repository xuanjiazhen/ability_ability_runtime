{
  "name": "ohos-claw-cc",
  "version": "1.0.0",
  "description": "InsightIntent framework CLI tool for executing and querying insight intents. Used for debugging and verifying intent registration 
    and execution during development. Does not support modifying or deleting intent registrations.",
  "executablePath": "/system/bin/cli_tool/executable/ohos-claw-cc",
  "requirePermissions": [],
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "properties": {}
  },
  "hasSubCommand": true,
  "subcommands": {
    "execute-intent": {
      "description": "Execute an insight intent synchronously and return the execution result. Used for triggering and verifying intent execution flow during development. Does not support asynchronous or background execution without waiting.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bundleName": {
            "type": "string",
            "description": "Target application bundle name",
            "minLength": 1
          },
          "moduleName": {
            "type": "string",
            "description": "Module name within the bundle",
            "minLength": 1
          },
          "intentName": {
            "type": "string",
            "description": "Insight intent name to execute",
            "minLength": 1
          },
          "abilityName": {
            "type": "string",
            "description": "Ability name",
            "minLength": 1
          },
          "executeMode": {
            "type": "integer",
            "description": "Execute mode: 0=UI_ABILITY_FOREGROUND, 1=UI_ABILITY_BACKGROUND, 2=UI_EXTENSION_ABILITY, 3=SERVICE_EXTENSION_ABILITY",
            "minimum": 0,
            "maximum": 3
          },
          "param": {
            "type": "string",
            "description": "Intent parameters as a JSON object string. Pass '{}' if not needed."
          }
        },
        "required": [
          "bundleName",
          "moduleName",
          "intentName",
          "abilityName",
          "executeMode",
          "param"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "innerErr": {
            "type": "integer",
            "description": "Intent execution internal error code. 0 = success"
          },
          "code": {
            "type": "integer",
            "description": "Business return code"
          },
          "flags": {
            "type": "integer",
            "description": "Return flags"
          },
          "result": {
            "type": "object",
            "description": "Structured execution result (WantParams)"
          },
          "uris": {
            "type": "array",
            "description": "Returned URI list",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "innerErr",
          "code",
          "flags"
        ]
      },
      "requirePermissions": []
    },
    "get-intent": {
      "description": "Query insight intent registration information with three query modes. Used for inspecting registered intents and their metadata during development.
        Does not support modifying or deleting intent registrations.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "executeMode": {
            "type": "integer",
            "description": "Query mode: 1=query all, 2=query by bundle, 3=query by intent name",
            "minimum": 1,
            "maximum": 3
          },
          "flag": {
            "type": "integer",
            "description": "Query flag (required, values: 1=GET_FULL_INSIGHT_INTENT, 2=GET_SUMMARY_INSIGHT_INTENT, 5=FULL+ENTITY_INFO, 6=SUMMARY+ENTITY_INFO)",
            "enum": [
              1,
              2,
              5,
              6
            ]
          },
          "userId": {
            "type": "integer",
            "description": "User ID (default: 100)",
            "minimum": 0,
            "default": 100
          },
          "bundleName": {
            "type": "string",
            "description": "Bundle name (required when executeMode is 2 or 3)"
          },
          "moduleName": {
            "type": "string",
            "description": "Module name (required when executeMode is 3)"
          },
          "intentName": {
            "type": "string",
            "description": "Intent name (required when executeMode is 3)"
          }
        },
        "required": [
          "executeMode",
          "flag"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Total count of matched intents"
          },
          "intents": {
            "type": "array",
            "description": "List of matched intent information",
            "items": {
              "type": "object",
              "properties": {
                "bundleName": {
                  "type": "string"
                },
                "moduleName": {
                  "type": "string"
                },
                "intentName": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string"
                },
                "intentType": {
                  "type": "string"
                },
                "developType": {
                  "type": "string"
                },
                "parameters": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "requirePermissions": []
    }
  }
}