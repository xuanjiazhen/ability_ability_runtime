{
    "name": "ohos-aa",
    "version": "1.0.0",
    "description": "启动所指定应用的Ability或终止指定的应用进程",
    "executable": "/system/bin/cli_tools/ohos-aa",
    "requirePermission": [],
    "hasSubcommands": true,
    
    "subcommand": {
        "help": {
            "description": "查看ohos-aa相关子命令的信息",
            "requiredPermission": [],
            "input": {
            },
            "output": {
                "type": "object",
                "description": "执行结果",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "message": {
                        "type": "string"
                    },
                    "code": {
                    	"type": "string"
                	},
                    "cause": {
                    	"type": "string"
                	},
                	"suggestion": {
                    	"type": "string"
                	}
                } 
            },
            "argumentMapping": {}
        },
        "version": {
            "description": "查看ohos-aa的版本信息",
            "requiredPermission": [],
            "input": {
            },
            "output": {
                "type": "object",
                "description": "执行结果",
                "properties": {
                    "success": {
	        			"type": "boolean"
                    },
                    "message": {
                        "type": "string"
                    },
                    "code": {
                    	"type": "string"
                	},
                    "cause": {
                    	"type": "string"
                	},
                	"suggestion": {
                    	"type": "string"
                	}
                } 
            },
            "argumentMapping": {}
        },
        "start": {
            "description": "启动指定应用的Ability",
            "requiredPermission": [],
            "input": {
                "type": "object",
                "properties": {
                    "help": {
                        "type": "boolean",
                        "default": false
                    },
                    "abilityName": {
                        "type": "string",
                        "description": "abilityName",
                        "default": ""
                    },
                    "bundleName": {
                        "type": "string",
                        "description": "bundleName",
                        "default": ""
                    },
                    "deviceId": {
                        "type": "string",
                        "description": "deviceId",
                        "default": ""
                    },
                    "moduleName": {
                        "type": "string",
                        "description": "moduleName",
                        "default": ""
                    },
                    "URI": {
                        "type": "string",
                        "description": "URI",
                        "default": ""
                    },
                    "action": {
                        "type": "string",
                        "description": "action",
                        "default": ""
                    },
                    "entity": {
                        "type": "string",
                        "description": "entity",
                        "default": ""
                    }, 
                    "type": {
                        "type": "string",
                        "description": "type",
                        "default": ""
                    }, 
                    "time": {
                        "type": "boolean",
                        "description": "time",
                        "default": false
                    },
                    "psn": {
                        "type": "string",
                        "description": "psn",
                        "default": ""
                    }
                }
            },
            "output": {
                "type": "object",
                "description": "执行结果",
                "properties": {
                    "success": {
	        			"type": "boolean"
                    },
                    "message": {
                        "type": "string"
                    },
                    "code": {
                    	"type": "string"
                	},
                    "cause": {
                    	"type": "string"
                	},
                	"suggestion": {
                    	"type": "string"
                	}
                } 
            },
            "argumentMapping": {
                "type": "flag",
                "templates": {
                    "help": "-h",
                    "abilityName": "-a={value}",
                    "bundleName": "-b={value}",
                    "deviceId": "-d={value}",
                    "moduleName": "-m={value}",
                    "URI": "-U={value}",
                    "action": "-A={value}",
                    "entity": "-e={value}",
                    "type": "-t={value}",
                    "time": "-W",
                    "psn": "--psn={value}"
                }
            }
        },
        "force-stop": {
            "description": "终止指定的应用进程",
            "requiredPermission": [],
            "input": {
                "type": "object",
                "properties": {
                    "bundleName": {
                        "type": "string",
                        "description": "bundleName"
                    }
                }
            },
            "output": {
                "type": "object",
                "description": "执行结果",
                "properties": {
                    "success": {
	        			"type": "boolean"
                    },
                    "message": {
                        "type": "string"
                    },
                    "code": {
                    	"type": "string"
                	},
                    "cause": {
                    	"type": "string"
                	},
                	"suggestion": {
                    	"type": "string"
                	}
                } 
            },
            "argumentMapping": {
                "bundleName": {
                    "mode": "positional",
                    "order": 1
                }
            }
        }
    },
    "timeout": 30000,
    "events": [],
    "eventSchemas": {}
