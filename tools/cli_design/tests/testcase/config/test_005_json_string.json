{
  "name": "ohos-test-005",
  "version": "1.0.0",
  "description": "JSON-String模式 - 复杂对象序列化",
  "executable": "/usr/bin/cloud-deploy",
  "input": {
    "type": "object",
    "properties": {
      "config": {
        "type": "object",
        "properties": {
          "resources": {
            "type": "object",
            "properties": {
              "cpu": {"type": "string"},
              "memory": {"type": "string"}
            }
          },
          "tags": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      },
      "mode": {"type": "string"}
    },
    "required": ["config"]
  },
  "argumentMapping": {
    "type": "json-string",
    "templates": {
      "config": "--config={value}",
      "mode": "--mode={value}"
    }
  }
}
