{
  "name": "ohos-test-009",
  "version": "1.0.0",
  "description": "Flag模式 - 布尔值if_false分支",
  "executable": "/usr/bin/logger",
  "input": {
    "type": "object",
    "properties": {
      "debug": {"type": "boolean"},
      "trace": {"type": "boolean"}
    }
  },
  "argumentMapping": {
    "type": "flag",
    "templates": {
      "debug": {
        "if_true": "--debug",
        "if_false": "--release"
      },
      "trace": {
        "if_true": "--trace-enable",
        "if_false": "--trace-disable"
      }
    }
  }
}
