{
  "name": "ohos-test-016",
  "version": "1.0.0",
  "description": "Mixed模式 - flag与flattened组合",
  "executable": "/usr/bin/deployer",
  "input": {
    "type": "object",
    "properties": {
      "force": {"type": "boolean"},
      "dryRun": {"type": "boolean"},
      "app": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "namespace": {"type": "string"},
          "replicas": {"type": "integer"}
        }
      }
    }
  },
  "argumentMapping": {
    "type": "mixed",
    "mappings": {
      "force": {
        "mode": "flag",
        "template": {
          "if_true": "--force",
          "if_false": ""
        }
      },
      "dryRun": {
        "mode": "flag",
        "template": {
          "if_true": "--dry-run",
          "if_false": ""
        }
      },
      "app": {
        "mode": "flattened",
        "template": {
          "app.name": "--app={value}",
          "app.namespace": "--namespace={value}",
          "app.replicas": "--replicas={value}"
        },
        "separator": "."
      }
    }
  }
}
