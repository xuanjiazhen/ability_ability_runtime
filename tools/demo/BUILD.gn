# Demo-only group wiring the appSpawn reverse-IPC probe bin into the
# tools_target graph so it builds as part of `hb build ability_runtime`.
# install_enable=false, so it is never installed into the system image.
group("demo_tools") {
  deps = [
    "ams_ipc_probe:ams_ipc_probe_rev",
  ]
}
