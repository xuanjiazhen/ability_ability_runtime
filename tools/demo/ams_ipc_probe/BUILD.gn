# Reverse-IPC probe bin: verifies AMS/AppMgr can call back into an
# appSpawn fork+exec'd bin via binder (IApplicationStateObserver callback).
#
# Build as part of the ability_runtime repo (like `aa`):
#   hb build ability_runtime -t
# or single target:
#   hb build ability_runtime -t --build-target ams_ipc_probe_rev
#
# install_enable=false: not installed into the system image; push manually.

import("//build/ohos.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

config("ams_ipc_probe_rev_config") {
  include_dirs = [
    "${ability_runtime_innerkits_path}/app_manager/include/appmgr",
    "${ability_runtime_innerkits_path}/ability_manager/include",
  ]

  cflags_cc = [ "-fexceptions" ]

  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }
}

ohos_executable("ams_ipc_probe_rev") {
  branch_protector_ret = "pac_ret"

  sources = [ "ams_ipc_probe_rev.cpp" ]

  configs = [ ":ams_ipc_probe_rev_config" ]

  deps = [
    "${ability_runtime_innerkits_path}/app_manager:app_manager",
  ]

  external_deps = [
    "ability_base:base",
    "ability_base:want",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]

  public_external_deps = [
    "bundle_framework:appexecfwk_base",
    "samgr:samgr_proxy",
  ]

  install_enable = false

  subsystem_name = "ability"
  part_name = "ability_runtime"
}
