import("//build/test.gni")
import("//foundation/ability/ability_runtime/ability_runtime.gni")

config("execute_intent_command_config") {
  include_dirs = [
    "include",
    "${ability_runtime_innerkits_path}/app_manager/include/appmgr",
    "${ability_runtime_services_path}/abilitymgr/include/utils",
    "${ability_runtime_services_path}/abilitymgr/include",
    "${ability_runtime_path}/frameworks/native/runtime",
    "//tools/aa/include",
  ]
}

config("execute_intent_command_exception_config") {
  cflags_cc = [ "-fexceptions" ]
}

ohos_static_library("tools_ei_source_set") {
  sources = [
    "src/ei_command.cpp",
    "//tools/aa/src/shell_command.cpp",
  ]

  public_configs = [
    ":execute_intent_command_config",
    ":execute_intent_command_exception_config",
    "${ability_runtime_services_path}/abilitymgr:abilityms_config",
    "${ability_runtime_services_path}/common:common_config",
  ]

  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }

  deps = [
    "${ability_runtime_innerkits_path}/ability_manager:ability_manager",
    "${ability_runtime_innerkits_path}/app_manager:app_manager",
    "${ability_runtime_innerkits_path}/runtime:runtime",
  ]

  external_deps = [
    "ability_base:base",
    "ability_base:want",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "hicollie:libhicollie",
    "hilog:libhilog",
    "ipc:ipc_core",
    "json:nlohmann_json_static",
  ]

  subsystem_name = "ability"
  part_name = "ability_runtime"
}

ohos_executable("ei") {
  sources = [ "src/main.cpp" ]

  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }

  deps = [
    ":tools_ei_source_set",
    "${ability_runtime_innerkits_path}/ability_manager:ability_manager",
  ]

  external_deps = [
    "ability_base:base",
    "c_utils:utils",
    "hicollie:libhicollie",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]

  install_enable = true

  subsystem_name = "ability"
  part_name = "ability_runtime"
}

ohos_prebuilt_etc("ei_command_executor_config.json") {
  source = "resource/ei_command_executor_config.json"
  subsystem_name = "ability"
  part_name = "ability_runtime"
}

group("tools_ei") {
  deps = [
    ":ei",
    ":ei_command_executor_config.json",
  ]
}
