{
  "name": "ohos-arktsScript",
  "version": "1.0.0",
  "description": "Run a specified skill function from an ArkTS module in a target application",
  "executablePath": "/system/bin/cli_tool/executable/ohos-arktsScript",
  "requirePermissions": [],
  "inputSchema": {
    "type": "object",
    "description": "Skill execution input parameters",
    "properties": {
      "bundleName": {
        "type": "string",
        "description": "Target application bundle name"
      },
      "moduleName": {
        "type": "string",
        "description": "Target module name within the application"
      },
      "skillName": {
        "type": "string",
        "description": "Name of the skill to execute"
      },
      "arkTSPath": {
        "type": "string",
        "description": "Relative path to the ArkTS source file (srcEntries)"
      },
      "funcName": {
        "type": "string",
        "description": "Function name to execute within the ArkTS module"
      }
    },
    "required": [
      "bundleName",
      "moduleName",
      "skillName"
    ]
  },
  "outputSchema": {
    "type": "object",
    "description": "CliSessionInfo returned by execTool",
    "properties": {
      "sessionId": {
        "type": "string",
        "description": "Request code generated by AMS for this skill execution"
      },
      "toolName": {
        "type": "string",
        "description": "Tool name, always \"ohos-arktsScript\""
      },
      "status": {
        "type": "string",
        "description": "Execution status: \"completed\" or \"failed\""
      },
      "result": {
        "type": "object",
        "description": "Execution result details",
        "properties": {
          "exitCode": {
            "type": "integer",
            "description": "Skill execution result code"
          },
          "outputText": {
            "type": "string",
            "description": "Skill return data serialized as JSON string"
          },
          "timedOut": {
            "type": "boolean",
            "description": "Whether the skill execution timed out"
          }
        },
        "required": [
          "exitCode"
        ]
      }
    },
    "required": [
      "sessionId",
      "toolName",
      "status"
    ]
  }
}
