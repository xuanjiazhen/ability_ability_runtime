{
  "name": "ohos-example",
  "version": "1.0.0",
  "description": "示例 CLI 工具，演示 CLI 工具规范实现（有子命令格式）",
  "executable": "/system/bin/cli_tool/tools/ohos-example",
  "hasSubcommands": true,
  "timeout": 30,
  "subcommands": {
    "run": {
      "description": "运行示例工具，执行并返回结果",
      "input": {
        "type": "object",
        "properties": {
          "argLine": {
            "type": "string",
            "description": "传递给工具的参数字符串"
          }
        }
      },
      "output": {
        "type": "object",
        "description": "执行结果",
        "properties": {
          "result": {
            "type": "string",
            "description": "执行结果字符串"
          }
        }
      },
      "events": ["progress", "result"],
      "eventSchemas": {
        "progress": {
          "type": "object",
          "description": "执行进度事件",
          "properties": {
            "percentage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "完成百分比"
            },
            "status": {
              "type": "string",
              "description": "当前状态"
            }
          },
          "required": ["percentage", "status"]
        }
      },
      "argumentMapping": {
        "type": "positional",
        "order": ["argLine"]
      }
    },
    "version": {
      "description": "显示版本信息",
      "input": {
        "type": "object",
        "properties": {
          "reserved": {
            "type": "string",
            "description": "预留占位参数，正常调用时无需传入"
          }
        }
      },
      "output": {
        "type": "object",
        "description": "版本信息",
        "properties": {
          "version": {
            "type": "string",
            "description": "工具版本号"
          },
          "build_time": {
            "type": "string",
            "description": "构建时间"
          }
        },
        "required": ["version"]
      },
      "events": ["result"],
      "argumentMapping": {
        "type": "flag",
        "templates": {
          "reserved": "--reserved={value}"
        }
      }
    }
  }
}
