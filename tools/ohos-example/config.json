{
  "name": "ohos-example",
  "version": "1.0.0",
  "description": "Example CLI tool, demonstrates CLI tool specification implementation (with subcommand format)",
  "executable": "/system/bin/cli_tool/executable/ohos-example",
  "hasSubcommands": true,
  "timeout": 30,
  "requirePermissions": [],
  "subcommands": {
    "run": {
      "description": "Run example tool, execute and return results",
      "input": {
        "type": "object",
        "properties": {
          "argLine": {
            "type": "string",
            "description": "Argument string to pass to the tool"
          }
        }
      },
      "output": {
        "type": "object",
        "description": "Execution result",
        "properties": {
          "result": {
            "type": "string",
            "description": "Execution result string"
          }
        }
      },
      "events": ["progress", "result"],
      "eventSchemas": {
        "progress": {
          "type": "object",
          "description": "Execution progress event",
          "properties": {
            "percentage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Completion percentage"
            },
            "status": {
              "type": "string",
              "description": "Current status"
            }
          },
          "required": ["percentage", "status"]
        }
      },
      "argumentMapping": {
        "type": "positional",
        "order": ["argLine"]
      }
    },
    "version": {
      "description": "Display version information",
      "input": {
        "type": "object",
        "properties": {
          "reserved": {
            "type": "string",
            "description": "Reserved placeholder parameter, not required for normal calls"
          }
        }
      },
      "output": {
        "type": "object",
        "description": "Version information",
        "properties": {
          "version": {
            "type": "string",
            "description": "Tool version number"
          },
          "build_time": {
            "type": "string",
            "description": "Build time"
          }
        },
        "required": ["version"]
      },
      "events": ["result"],
      "argumentMapping": {
        "type": "flag",
        "templates": {
          "reserved": "--reserved={value}"
        }
      }
    }
  }
}
