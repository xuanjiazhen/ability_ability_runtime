{
  "name": "ohos-simple",
  "version": "1.0.0",
  "description": "Simple CLI tool, supports message output, repeat count and verbose mode",
  "executable": "/system/bin/cli_tool/executable/ohos-simple",
  "timeout": 30,
  "requirePermissions": [],
  "events": ["result"],
  "input": {
    "type": "object",
    "description": "Tool input parameters",
    "properties": {
      "message": {
        "type": "string",
        "description": "Message content to output",
        "default": "Hello from ohos-simple",
        "minLength": 1
      },
      "count": {
        "type": "integer",
        "description": "Message repeat count, actual implementation will limit between 1 and 10",
        "default": 1,
        "minimum": 1,
        "maximum": 10
      },
      "verbose": {
        "type": "boolean",
        "description": "Whether to output detailed process information",
        "default": false
      }
    }
  },
  "output": {
    "type": "object",
    "description": "Tool execution result",
    "properties": {
      "status": {
        "type": "string",
        "description": "Execution status, success when completed successfully"
      },
      "message": {
        "type": "string",
        "description": "Processed output message"
      },
      "repeat_count": {
        "type": "integer",
        "description": "Actual repeat count"
      }
    },
    "required": ["status", "message", "repeat_count"]
  },
  "argumentMapping": {
    "type": "flag",
    "templates": {
      "message": "--message={value}",
      "count": "--count={value}",
      "verbose": {
        "if_true": "--verbose",
        "if_false": ""
      }
    }
  }
}
