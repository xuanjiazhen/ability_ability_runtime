{
  "name": "ohos-pkgmgr",
  "version": "1.0.0",
  "description": "Package management tool with subcommands",
  "executable": "/usr/bin/pkg-mgr",
  "timeout": 300,
  "requirePermissions":["ohos.permission.INSTALL_BUNDLE"],
  "input": {
    "type": "object",
    "properties": {
      "verbose": {
        "type": "boolean",
        "default": false
      },
      "array": {
        "type": "array",
        "description": "dad",
        "items": {
          "type": "integer"
        },
        "maxItems": 3,
        "minItems": 2,
        "default": [12, 2, 3],
        "uniqueItems": true
      },
      "str": {
        "type": "string"
      },
      "num": {
        "type": "number"
      },
      "int" : {
        "type": "integer"
      }
    }
  },
  "argumentMapping": {
    "type": "flag",
    "templates": {
      "verbose": {
        "if_true": "--verbose",
        "if_false": ""
      },
      "array": "--array={value}",
      "num": "--num={value}",
      "str": "--str={value}",
      "int": "--int={value}"
    }
  },
  "output": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string"
      }
    },
    "required": ["status"]
  },
  "events": ["result"],
  "hasSubcommands": true,
  "subcommands": {
    "install": {
      "description": "Install a package",
      "input": {
        "type": "object",
        "properties": {
          "package": {
            "type": "string"
          },
          "force": {
            "type": "boolean",
            "default": false
          }
        },
        "required": ["package"]
      },
      "output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "eventSchemas": {
        "stdout1AS.ADDA-": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "trace": {
              "type": "object",
              "properties": {}
            }
          },
          "required": ["trace"]
        }
      },
      "events": ["result", "stdout","stderr","exit","error", "stdout1AS.ADDA-"],
      "argumentMapping": {
        "type": "flag",
        "templates": {
          "package": "{value}",
          "force": {
            "if_true": "--force",
            "if_false": ""
          }
        }
      }
    }
  }
}
