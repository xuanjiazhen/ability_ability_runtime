{
  "name": "ohos-scanner",
  "version": "1.0.0",
  "description": "Network scanning utility tool",
  "executable": "/usr/bin/net-scan",
  "input": {
    "type": "object",
    "properties": {
      "array": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "str": {
        "type": "string"
      },
      "num": {
        "type": "number"
      },
      "int" : {
        "type": "integer"
      },
      "bool" : {
        "type": "boolean"
      },
      "obj": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    }
  },
  "argumentMapping": {
    "type": "flag",
    "templates": {
      "array": "--array={value}",
      "str": "--str={value}",
      "num": "--num={value}",
      "int": "--int={value}",
      "bool": {
        "if_true":"--bool",
        "if_false":""
      },
      "obj": "--obj={value}"
    }
  }
}
