{
  "name": "ohos-scanner",
  "version": "1.0.0",
  "description": "Network scanning utility tool",
  "executablePath": "/usr/bin/net-scan",
  "inputSchema": {
    "type": "object",
    "properties": {
      "cfg": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          }
        }
      }
    }
  },
  "argMapping": {
    "type": "flattened",
    "separator": "/",
    "templates": {
      "cfg.host": "--host={value}"
    }
  }
}
