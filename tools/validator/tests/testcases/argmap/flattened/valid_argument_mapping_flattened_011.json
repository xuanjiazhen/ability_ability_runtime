{
  "name": "ohos-scanner",
  "version": "1.0.0",
  "description": "Network scanning utility tool",
  "executable": "/usr/bin/net-scan",
  "input": {
    "type": "object",
    "properties": {
      "cfg": {
        "type": "object",
        "properties": {
          "ports": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
  "argumentMapping": {
    "type": "flattened",
    "templates": {
      "cfg.ports": "--ports={value}"
    }
  }
}
