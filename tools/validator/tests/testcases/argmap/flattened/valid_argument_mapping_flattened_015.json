{
  "name": "ohos-scanner",
  "version": "1.0.0",
  "description": "Network scanning utility tool",
  "executablePath": "/usr/bin/net-scan",
  "inputSchema": {
    "type": "object",
    "properties": {
      "cfg": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          }
        }
      }
    }
  },
  "argMapping": {
    "type": "flattened",
    "separator": ".",
    "templates": {
      "cfg.host": "--host={value}",
      "cfg.port": "--port={value}"
    }
  }
}
