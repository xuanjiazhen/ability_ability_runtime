{
  "name": "ohos-scanner",
  "version": "1.0.0",
  "description": "Deep flattened mapping with underscore separator",
  "executablePath": "/usr/bin/net-scan",
  "inputSchema": {
    "type": "object",
    "properties": {
      "cfg": {
        "type": "object",
        "properties": {
          "network": {
            "type": "object",
            "properties": {
              "endpoint": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "host": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "argMapping": {
    "type": "flattened",
    "separator": "_",
    "templates": {
      "cfg_network_endpoint_enabled": {
        "if_true": "--enabled",
        "if_false": ""
      },
      "cfg_network_endpoint_host": "--host={value}"
    }
  }
}
