{
  "name": "ohos-mixed-json",
  "version": "1.0.0",
  "description": "Valid mixed jsonString mapping",
  "executablePath": "/usr/bin/mixed-tool",
  "inputSchema": {
    "type": "object",
    "properties": {
      "config": {
        "type": "object",
        "properties": {}
      }
    }
  },
  "argMapping": {
    "type": "mixed",
    "mappings": {
      "config": {
        "mode": "jsonString",
        "template": "--config={value}"
      }
    }
  }
}
