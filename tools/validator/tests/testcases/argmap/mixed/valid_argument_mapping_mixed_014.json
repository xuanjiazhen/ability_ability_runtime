{
  "name": "ohos-mixed-complex",
  "version": "1.0.0",
  "description": "Complex valid mixed mapping",
  "executablePath": "/usr/bin/mixed-tool",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string"
      },
      "service": {
        "type": "string"
      },
      "replicas": {
        "type": "integer"
      },
      "verbose": {
        "type": "boolean"
      },
      "dryRun": {
        "type": "boolean"
      },
      "server": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "tls": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "config": {
        "type": "object",
        "properties": {
          "resources": {
            "type": "object",
            "properties": {
              "cpu": {
                "type": "string"
              },
              "memory": {
                "type": "string"
              },
              "storage": {
                "type": "string"
              }
            }
          },
          "logging": {
            "type": "object",
            "properties": {
              "level": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          },
          "rollout": {
            "type": "object",
            "properties": {
              "batchSize": {
                "type": "integer"
              },
              "maxUnavailable": {
                "type": "integer"
              },
              "strategy": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "argMapping": {
    "type": "mixed",
    "mappings": {
      "action": {
        "mode": "positional",
        "order": 1
      },
      "service": {
        "mode": "positional",
        "order": 2
      },
      "replicas": {
        "mode": "flag",
        "template": "--replicas={value}"
      },
      "verbose": {
        "mode": "flag",
        "template": {
          "if_true": "--verbose",
          "if_false": ""
        }
      },
      "dryRun": {
        "mode": "flag",
        "template": "--dry-run={value}"
      },
      "server": {
        "mode": "flattened",
        "template": {
          "server.host": "--host={value}",
          "server.port": "--port={value}",
          "server.tls.enabled": "--tls-enabled={value}"
        },
        "separator": "."
      },
      "config": {
        "mode": "jsonString",
        "template": "--config={value}"
      }
    }
  }
}
