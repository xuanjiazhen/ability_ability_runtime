{
  "name": "ohos-mixed-complex",
  "version": "1.0.0",
  "description": "Duplicate positional order in mixed mapping",
  "executable": "/usr/bin/mixed-tool",
  "input": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string"
      },
      "target": {
        "type": "string"
      }
    }
  },
  "argumentMapping": {
    "type": "mixed",
    "mappings": {
      "action": {
        "mode": "positional",
        "order": 1
      },
      "target": {
        "mode": "positional",
        "order": 1
      }
    }
  }
}
