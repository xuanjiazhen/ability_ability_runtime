{
  "name": "ohos-mixed-all-types",
  "version": "1.0.0",
  "description": "Valid mixed mapping covering legal field types across modes",
  "executablePath": "/usr/bin/mixed-tool",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string"
      },
      "count": {
        "type": "integer"
      },
      "ratio": {
        "type": "number"
      },
      "verbose": {
        "type": "boolean"
      },
      "dryRun": {
        "type": "boolean"
      },
      "server": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          }
        }
      },
      "config": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "argMapping": {
    "type": "mixed",
    "mappings": {
      "action": {
        "mode": "positional",
        "order": 1
      },
      "count": {
        "mode": "flag",
        "template": "--count={value}"
      },
      "ratio": {
        "mode": "flag",
        "template": "--ratio={value}"
      },
      "verbose": {
        "mode": "flag",
        "template": {
          "if_true": "--verbose",
          "if_false": ""
        }
      },
      "dryRun": {
        "mode": "flag",
        "template": "--dry-run={value}"
      },
      "server": {
        "mode": "flattened",
        "template": {
          "server.host": "--host={value}",
          "server.port": "--port={value}"
        },
        "separator": "."
      },
      "config": {
        "mode": "jsonString",
        "template": "--config={value}"
      }
    }
  }
}
